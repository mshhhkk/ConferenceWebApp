@model ConferenceWebApp.Application.DTOs.PersonalAccountDTOs.InvitationDTO
@using ConferenceWebApp.Application

@{
    ViewData["Title"] = "Приглашение";
    Layout = "_Layout"; // или печатный _PrintLayout, если есть
}

<link rel="stylesheet" href="~/css/invitation.css" />

<div class="invitation">
    <div class="inv-header">
        <div class="inv-conf">КВАНТОВАЯ ЭЛЕКТРОНИКА (КЭ'2025)</div>
        <div class="inv-sub">Международная научно-техническая конференция</div>
        <div class="inv-dates">@Model.Dates</div>
        <div class="inv-venue">@Model.Venue</div>
    </div>

    <p class="inv-greeting">@Model.GreetingName</p>

    @if (Model.Reports.Count == 0)
    {
        <p>На текущий момент нет принятых докладов, привязанных к вашей учётной записи.</p>
    }
    else
    {
        <p>По поручению Оргкомитета сообщаем, что следующие ваши доклады приняты к представлению:</p>
        <ul class="inv-list">
            @foreach (var r in Model.Reports)
            {
                <li>
                    «@r.Title», принято к представлению <strong>в качестве @r.WorkTypeText</strong>.
                    <br />
                    Секция: <em>@r.SectionText</em>
                </li>
            }
        </ul>
    }

    <h4>Организационный взнос</h4>
    @if (Model.IsStudent)
    {
        <p>Студенты и магистранты освобождены от уплаты оргвзноса.</p>
    }
    else
    {
        <p>Величина оргвзноса составляет 90 руб. Все расходы по участию несёт командирующая сторона.</p>
        <p><small>Банковские реквизиты будут направлены дополнительно.</small></p>
    }

    <div class="inv-sign">
        <p>С уважением,</p>
        <p>Председатель Оргкомитета<br />доктор физ.-мат. наук, профессор<br />М. М. Кугейко</p>
    </div>
</div>
