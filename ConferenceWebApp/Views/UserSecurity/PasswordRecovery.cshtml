@using ConferenceWebApp.Application.DTOs;
@model PasswordRecoveryDTO
@{
    ViewData["Title"] = "Восстановление пароля";
    Layout = "_AuthLayout";
}
<link rel="stylesheet" href="~/css/global.css" />
<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-left">
            <div class="auth-left-overlay"></div>
            <div class="auth-left-content">
                <div class="auth-welcome-title">Забыли пароль?</div>
                <div class="auth-welcome-desc">Мы пришлём ссылку для сброса на вашу почту</div>
            </div>
        </div>

        <div class="auth-right">
            <div class="auth-form-block">
                <h2>Восстановление пароля</h2>
                <form asp-action="PasswordRecovery" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div>
                        <label asp-for="Email">Адрес электронной почты</label>
                        <input asp-for="Email" type="email" placeholder="Введите ваш email" />
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="form-action">
                        <button type="submit">Отправить ссылку</button>
                    </div>
                    <div class="form-link">
                        Вспомнили пароль? <a href="/Auth/Login">Войти</a>
                    </div>
                </form>
            </div>
            <partial name="_FlashModals" />
        </div>
    </div>
</div>
