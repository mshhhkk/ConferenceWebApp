@using ConferenceWebApp.Application.DTOs;
@model ResetPasswordDTO
@{
    ViewData["Title"] = "Сброс пароля";
    Layout = "_AuthLayout";
}
<link rel="stylesheet" href="~/css/global.css" />
<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-left">
            <div class="auth-left-overlay"></div>
            <div class="auth-left-content">
                <div class="auth-welcome-title">Сброс пароля</div>
                <div class="auth-welcome-desc">Задайте новый надёжный пароль</div>
            </div>
        </div>

        <div class="auth-right">
            <div class="auth-form-block">
                <h2>Новый пароль</h2>
                <form asp-action="ResetPassword" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Token" />
                    <div>
                        <label asp-for="NewPassword">Новый пароль</label>
                        <input asp-for="NewPassword" type="password" placeholder="********" />
                        <span asp-validation-for="NewPassword"></span>
                    </div>
                    <div>
                        <label asp-for="NewPasswordRepeat">Повторите пароль</label>
                        <input asp-for="NewPasswordRepeat" type="password" placeholder="********" />
                        <span asp-validation-for="NewPasswordRepeat"></span>
                    </div>
                    <div class="form-action">
                        <button type="submit">Сохранить</button>
                    </div>
                    <div class="form-link">
                        Вспомнили пароль? <a href="/Auth/Login">Войти</a>
                    </div>
                </form>
            </div>
            <partial name="_FlashModals" />
        </div>
    </div>
</div>
